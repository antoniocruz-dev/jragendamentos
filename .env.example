# ==========================================================
# Backend (serviço "app" na Vercel) — copie para .env em dev
# ==========================================================

# PostgreSQL — conexão COM pooling, usada em runtime pelas funções serverless.
# Neon:     host com "-pooler"           ex.: ...@ep-xxx-pooler.sa-east-1.aws.neon.tech/db?sslmode=require
# Supabase: porta 6543 (Supavisor)       ex.: ...@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# Dica: em serverless acrescente &connection_limit=1 para não esgotar conexões.
DATABASE_URL="postgresql://usuario:senha@localhost:5432/jragendamentos_db?schema=public"

# PostgreSQL — conexão DIRETA (sem pooler), usada só pelo `prisma migrate`.
# Em dev local pode ser igual à DATABASE_URL.
DIRECT_URL="postgresql://usuario:senha@localhost:5432/jragendamentos_db?schema=public"

# Segredo para assinar os tokens JWT (use um valor longo e aleatório em produção)
JWT_SECRET="troque-por-um-segredo-forte"

# Porta local da API (a Vercel define PORT sozinha em produção)
PORT=3001

# Origens permitidas no CORS, separadas por vírgula (opcional; vazio = todas).
# Em produção front e back ficam no mesmo domínio, então normalmente não é necessário.
CORS_ORIGIN=

# Mercado Pago (PIX)
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=

# Origem pública da aplicação, SEM "/api" no final.
# O webhook do Mercado Pago será ${API_PUBLIC_URL}/api/payments/webhook
# Produção: https://seu-projeto.vercel.app  |  Dev: URL do ngrok apontando para a porta 3001
API_PUBLIC_URL="https://seu-projeto.vercel.app"
