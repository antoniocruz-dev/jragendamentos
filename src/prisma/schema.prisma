datasource db {
  provider  = "postgresql"
  // Runtime (funções serverless da Vercel): use a URL COM pooling (PgBouncer / pooler do provedor)
  url       = env("DATABASE_URL")
  // Migrations (prisma migrate): conexão DIRETA, sem pooler
  directUrl = env("DIRECT_URL")
}

generator client {
  provider      = "prisma-client-js"
  // "native" para o ambiente local; "rhel-openssl-3.0.x" é o Linux das funções da Vercel
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

// ==========================================
// ENUMS DO DOMÍNIO
// ==========================================

enum UserRole {
  ADMIN
  OPERATOR
  CLIENT
}

// Perfis (cargos) da equipe da oficina. As permissões de cada perfil ficam em ProfilePermission.
enum StaffProfile {
  ADMINISTRADOR
  GERENTE_GERAL
  MECANICO_CHEFE
  MECANICO
  AUXILIAR_OFICINA
  AUXILIAR_ADMINISTRATIVO
}

enum WorkOrderStatus {
  DRAFT // Rascunho inicial
  QUOTE // Orçamento aguardando aprovação
  APPROVED // Orçamento aprovado pelo cliente
  IN_PROGRESS // Em execução na oficina
  WAITING_PARTS // Bloqueado aguardando peças
  TESTING // Em teste (rodagem / conferência final)
  COMPLETED // Serviço concluído fisicamente
  BILLED // Faturado e pago
  CANCELLED // Cancelado
}

/// Decisão do cliente sobre o orçamento
enum BudgetStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Tipo da observação registrada na OS
enum ObservationType {
  ORCAMENTO_CLIENTE // Cliente ao aprovar/reprovar o orçamento
  TECNICA_MECANICO // Nota técnica do mecânico
  REABERTURA // Justificativa de reabertura
  ATRIBUICAO_MECANICO // Atribuição/troca do mecânico responsável
}

/// Papel de quem escreveu a observação (CLIENTE, MECANICO, GESTOR, ADMIN)
enum ObservationAuthorRole {
  CLIENTE
  MECANICO
  GESTOR
  ADMIN
}

enum WorkOrderItemType {
  SERVICE
  PRODUCT
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  ATTENDED
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum TransactionStatus {
  PENDING
  PAID
  CANCELLED
}

enum PaymentMethod {
  PIX
  CREDIT_CARD
  DEBIT_CARD
  CASH
  BANK_TRANSFER
}

// Quem pagou a despesa (planilha: "Quem Pagou")
enum ExpensePayer {
  CAIXA
  SOCIO
}

// Regime tributário da oficina (define como o ISS é recolhido)
enum TaxRegime {
  SIMPLES_NACIONAL
  LUCRO_PRESUMIDO
  LUCRO_REAL
  MEI
}

enum PaymentGateway {
  MERCADO_PAGO
  MANUAL
}

/// Situação do estorno de uma OS faturada que foi cancelada (o caixa e o estoque não voltam sozinhos)
enum RefundStatus {
  PENDING // Aguardando auditoria do Administrador
  REFUNDED // Estorno feito: entrada do caixa cancelada (e peças devolvidas, se marcado)
  WAIVED // Sem devolução ao cliente: a receita permanece
}

enum AlertType {
  STOCK_SHORTAGE // OS aprovada sem peças suficientes (foi para Aguardando Peças)
  PAYMENT_REJECTED // Pagamento recusado pelo Mercado Pago
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  REFUNDED
}

// ==========================================
// AUTENTICAÇÃO E PERFIS
// ==========================================

model User {
  id                 String        @id @default(uuid()) @db.Uuid
  name               String        @db.VarChar(150)
  email              String        @unique @db.VarChar(255)
  passwordHash       String        @map("password_hash") @db.VarChar(255)
  phone              String?       @db.VarChar(20)
  /// Código de acesso de 4 dígitos (login), gerado pelo banco: gen_access_code()
  accessCode         String        @unique @default(dbgenerated("gen_access_code()")) @map("access_code") @db.Char(4)
  /// WhatsApp (11 dígitos, DDD + número) para onde vão as credenciais
  whatsapp           String?       @db.VarChar(20)
  /// Conta da equipe criada pelo gestor sem senha: a pessoa define no "primeiro acesso"
  firstAccessPending Boolean       @default(false) @map("first_access_pending")
  role               UserRole      @default(CLIENT)
  // Cargo do usuário da equipe (null para usuários CLIENT)
  profile            StaffProfile?
  isActive           Boolean       @default(true) @map("is_active")
  // Comissão do mecânico sobre a mão de obra (%), ajustável na tela Equipe
  commissionRate     Decimal       @default(50) @map("commission_rate") @db.Decimal(5, 2)

  client           Client?
  expensesReceived CashTransaction[]      @relation("ExpenseBeneficiary")
  workOrders       WorkOrder[]            @relation("OperatorWorkOrders")
  /// Serviços de OS executados por este mecânico (pode haver vários mecânicos na mesma OS)
  serviceItems     WorkOrderItem[]        @relation("ItemMechanic")
  observations     WorkOrderObservation[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([role])
  @@map("users")
}

// Módulos do sistema liberados para cada perfil (configurável na tela Equipe).
// Valores de `modules`: DASHBOARD, WORK_ORDERS, CLIENTS, CATALOG, APPOINTMENTS, FINANCIAL.
// ADMINISTRADOR sempre tem acesso total, independentemente desta tabela.
model ProfilePermission {
  profile StaffProfile @id
  modules String[]

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("profile_permissions")
}

model Client {
  id       String  @id @default(uuid()) @db.Uuid
  userId   String? @unique @map("user_id") @db.Uuid
  name     String  @db.VarChar(150)
  /// CPF ou CNPJ (somente números). Opcional: o cliente que entra pelo painel informa só nome, e-mail e contato
  document String? @unique @db.VarChar(20)
  phone    String  @db.VarChar(20)
  email    String? @db.VarChar(255)
  address  String? @db.VarChar(255)
  city     String? @db.VarChar(100)
  state    String? @db.Char(2)

  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  vehicles     Vehicle[]
  workOrders   WorkOrder[]
  appointments Appointment[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([document])
  @@index([name])
  @@map("clients")
}

model Vehicle {
  id           String  @id @default(uuid()) @db.Uuid
  clientId     String  @map("client_id") @db.Uuid
  licensePlate String  @unique @map("license_plate") @db.VarChar(10) // Padrão Mercosul ou Antigo
  brand        String  @db.VarChar(60)
  model        String  @db.VarChar(80)
  year         Int
  color        String? @db.VarChar(30)
  currentKm    Int     @default(0) @map("current_km")
  chassis      String? @db.VarChar(30)
  notes        String? @db.Text

  client       Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  workOrders   WorkOrder[]
  appointments Appointment[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([licensePlate])
  @@index([clientId])
  @@map("vehicles")
}

// ==========================================
// CATÁLOGO DE PRODUTOS E SERVIÇOS
// ==========================================

model Service {
  id               String  @id @default(uuid()) @db.Uuid
  name             String  @db.VarChar(120)
  description      String? @db.Text
  basePrice        Decimal @map("base_price") @db.Decimal(10, 2)
  estimatedMinutes Int     @default(60) @map("estimated_minutes")
  isActive         Boolean @default(true) @map("is_active")

  items WorkOrderItem[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isActive])
  @@map("services")
}

model Product {
  id            String  @id @default(uuid()) @db.Uuid
  sku           String  @unique @db.VarChar(50) // Código interno ou de barras
  name          String  @db.VarChar(150)
  description   String? @db.Text
  costPrice     Decimal @map("cost_price") @db.Decimal(10, 2)
  salePrice     Decimal @map("sale_price") @db.Decimal(10, 2)
  stockQuantity Int     @default(0) @map("stock_quantity")
  minStock      Int     @default(2) @map("min_stock")
  isActive      Boolean @default(true) @map("is_active")

  items     WorkOrderItem[]
  movements StockMovement[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([sku])
  @@index([isActive])
  @@map("products")
}

// ==========================================
// ORDENS DE SERVIÇO E ITENS
// ==========================================

model WorkOrder {
  id           String          @id @default(uuid()) @db.Uuid
  code         Int             @unique @default(autoincrement()) // OS #1001, #1002...
  clientId     String          @map("client_id") @db.Uuid
  vehicleId    String          @map("vehicle_id") @db.Uuid
  operatorId   String?         @map("operator_id") @db.Uuid
  status       WorkOrderStatus @default(DRAFT)
  /// Decisão do cliente sobre o orçamento
  budgetStatus BudgetStatus    @default(PENDING) @map("budget_status")
  /// Reaberturas depois de concluída (o mecânico só pode reabrir quando é 0)
  reopenCount  Int             @default(0) @map("reopen_count")

  totalServices Decimal @default(0.00) @map("total_services") @db.Decimal(10, 2)
  totalProducts Decimal @default(0.00) @map("total_products") @db.Decimal(10, 2)
  discount      Decimal @default(0.00) @db.Decimal(10, 2)
  finalAmount   Decimal @default(0.00) @map("final_amount") @db.Decimal(10, 2)

  reportedIssue  String? @map("reported_issue") @db.Text // Relato do cliente
  technicalNotes String? @map("technical_notes") @db.Text // Diagnóstico mecânico

  client       Client            @relation(fields: [clientId], references: [id], onDelete: Restrict)
  vehicle      Vehicle           @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  operator     User?             @relation("OperatorWorkOrders", fields: [operatorId], references: [id], onDelete: SetNull)
  items        WorkOrderItem[]
  transactions CashTransaction[]
  paymentLogs  PaymentLog[]

  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  finishedAt DateTime? @map("finished_at")

  // Fechamento financeiro (preenchido ao registrar o pagamento; valores congelados na data)
  billedAt       DateTime?      @map("billed_at")
  paymentMethod  PaymentMethod? @map("payment_method")
  installments   Int?
  issRate        Decimal?       @map("iss_rate") @db.Decimal(5, 2)
  commissionRate Decimal?       @map("commission_rate") @db.Decimal(5, 2)

  /// As peças da OS já saíram do estoque (baixa feita na aprovação)
  stockReserved Boolean @default(false) @map("stock_reserved")

  // Cancelamento (de OS faturada gera pendência de estorno manual)
  cancelledAt      DateTime?     @map("cancelled_at")
  cancelReason     String?       @map("cancel_reason") @db.Text
  refundStatus     RefundStatus? @map("refund_status")
  refundResolvedAt DateTime?     @map("refund_resolved_at")
  refundResolvedBy String?       @map("refund_resolved_by") @db.VarChar(150)
  refundNotes      String?       @map("refund_notes") @db.Text

  stockMovements StockMovement[]
  alerts         SystemAlert[]
  observations   WorkOrderObservation[]

  @@index([billedAt])
  @@index([clientId])
  @@index([vehicleId])
  @@index([status])
  @@index([createdAt])
  @@index([refundStatus])
  @@index([operatorId])
  @@map("work_orders")
}

model WorkOrderItem {
  id          String            @id @default(uuid()) @db.Uuid
  workOrderId String            @map("work_order_id") @db.Uuid
  itemType    WorkOrderItemType @map("item_type")
  serviceId   String?           @map("service_id") @db.Uuid
  productId   String?           @map("product_id") @db.Uuid
  /// Mecânico que executa este serviço (só itens SERVICE). Vazio: o responsável da OS.
  mechanicId  String?           @map("mechanic_id") @db.Uuid

  quantity   Int     @default(1)
  unitPrice  Decimal @map("unit_price") @db.Decimal(10, 2)
  totalPrice Decimal @map("total_price") @db.Decimal(10, 2)
  // Custo unitário da peça no momento da OS (custo de saída). Serviços: 0
  unitCost   Decimal @default(0) @map("unit_cost") @db.Decimal(10, 2)

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  service   Service?  @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  product   Product?  @relation(fields: [productId], references: [id], onDelete: Restrict)
  mechanic  User?     @relation("ItemMechanic", fields: [mechanicId], references: [id], onDelete: SetNull)

  @@index([workOrderId])
  @@index([serviceId])
  @@index([productId])
  @@index([mechanicId])
  @@map("work_order_items")
}

/// Observações da OS: orçamento (cliente), notas técnicas (mecânico) e reaberturas
model WorkOrderObservation {
  id          String                @id @default(uuid()) @db.Uuid
  workOrderId String                @map("os_id") @db.Uuid
  authorId    String?               @map("author_id") @db.Uuid
  authorName  String                @map("author_name") @db.VarChar(150)
  authorRole  ObservationAuthorRole @map("author_role")
  type        ObservationType
  message     String                @db.Text
  createdAt   DateTime              @default(now()) @map("created_at")

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  author    User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([workOrderId, createdAt])
  @@map("os_observations")
}

// ==========================================
// AGENDAMENTO
// ==========================================

model Appointment {
  id           String            @id @default(uuid()) @db.Uuid
  clientId     String            @map("client_id") @db.Uuid
  vehicleId    String            @map("vehicle_id") @db.Uuid
  scheduledFor DateTime          @map("scheduled_for")
  /// Serviço pedido pelo cliente no agendamento (ex.: revisão, troca de óleo)
  serviceType  String?           @map("service_type") @db.VarChar(255)
  status       AppointmentStatus @default(PENDING)
  notes        String?           @db.Text

  client  Client  @relation(fields: [clientId], references: [id], onDelete: Restrict)
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([scheduledFor])
  @@index([clientId])
  @@index([status])
  @@map("appointments")
}

// ==========================================
// FINANCEIRO, CAIXA E GATEWAY
// ==========================================

model CashTransaction {
  id            String            @id @default(uuid()) @db.Uuid
  workOrderId   String?           @map("work_order_id") @db.Uuid
  type          TransactionType
  category      String            @db.VarChar(80) // ex.: "FATURAMENTO_OS", "PEÇAS_FORNECEDOR", "ALUGUEL"
  amount        Decimal           @db.Decimal(10, 2)
  paymentMethod PaymentMethod     @map("payment_method")
  status        TransactionStatus @default(PENDING)
  notes         String?           @db.Text
  paidAt        DateTime?         @map("paid_at")
  // Despesas: descrição, quem pagou e o mecânico beneficiado (pagamento de comissão)
  description   String?           @db.VarChar(255)
  paidBy        ExpensePayer?     @map("paid_by")
  beneficiaryId String?           @map("beneficiary_id") @db.Uuid
  installments  Int?
  /// Contas a pagar: vencimento da despesa (status PENDING até a baixa; paidAt fica nulo até lá)
  dueDate       DateTime?         @map("due_date")

  workOrder   WorkOrder? @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  beneficiary User?      @relation("ExpenseBeneficiary", fields: [beneficiaryId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([type])
  @@index([status])
  @@index([paidAt])
  @@index([dueDate])
  @@index([createdAt])
  @@map("cash_transactions")
}

model PaymentLog {
  id                String         @id @default(uuid()) @db.Uuid
  workOrderId       String         @map("work_order_id") @db.Uuid
  externalPaymentId String?        @unique @map("external_payment_id") @db.VarChar(100) // ID retornado pelo Mercado Pago
  gateway           PaymentGateway @default(MERCADO_PAGO)
  status            PaymentStatus  @default(PENDING)
  payload           Json? // Webhook bruto recebido para auditoria e idempotência

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([workOrderId])
  @@index([externalPaymentId])
  @@map("payment_logs")
}

// Configuração fiscal da oficina (linha única, id = 1)
model FinancialSettings {
  id           Int       @id @default(1)
  taxRegime    TaxRegime @default(SIMPLES_NACIONAL) @map("tax_regime")
  // Alíquota de ISS aplicada sobre a mão de obra (%). Parauapebas/PA, item 14.01 da LC 116/2003: 5%
  issRate      Decimal   @default(5) @map("iss_rate") @db.Decimal(5, 2)
  municipality String    @default("Parauapebas/PA") @db.VarChar(100)
  serviceCode  String    @default("14.01") @map("service_code") @db.VarChar(10)
  companyName  String    @default("JR Garage Center") @map("company_name") @db.VarChar(150)

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("financial_settings")
}

// ==========================================
// ESTOQUE, ALERTAS E SEGURANÇA
// ==========================================

/// Histórico de entradas e saídas de peças (auditoria)
model StockMovement {
  id          String   @id @default(uuid()) @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  quantity    Int // positivo = entrada, negativo = saída
  balance     Int // saldo após o movimento
  reason      String   @db.VarChar(255)
  workOrderId String?  @map("work_order_id") @db.Uuid
  userName    String?  @map("user_name") @db.VarChar(150)
  createdAt   DateTime @default(now()) @map("created_at")

  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  workOrder WorkOrder? @relation(fields: [workOrderId], references: [id], onDelete: SetNull)

  @@index([productId, createdAt])
  @@map("stock_movements")
}

/// Avisos para a equipe (Dashboard): falta de peças, pagamento recusado...
model SystemAlert {
  id          String    @id @default(uuid()) @db.Uuid
  type        AlertType
  message     String    @db.VarChar(500)
  workOrderId String?   @map("work_order_id") @db.Uuid
  resolvedAt  DateTime? @map("resolved_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  workOrder WorkOrder? @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@index([resolvedAt, createdAt])
  @@map("system_alerts")
}

/// Janela de tentativas de login por IP (limite contra força bruta, vale entre instâncias)
model AuthRateLimit {
  key         String   @id @db.VarChar(120)
  windowStart DateTime @map("window_start")
  count       Int

  @@map("auth_rate_limits")
}
