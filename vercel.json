{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "nestjs"
    },
    "frontend": {
      "root": "front-end/frontend",
      "framework": "nextjs"
    }
  },
  "crons": [{ "path": "/api/cron/payables-reminder", "schedule": "0 10 * * *" }],
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "app" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}
